rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Perfil privado (sem leitura pública da coleção users)
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Presentes: leitura pública (convidados), escrita do dono
      match /products/{productId} {
        allow read: if true;
        allow create, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          || (
            // Reserva/pagamento por convidado: só muda campos de reserva
            // (docs antigos sem `status` e com reservedBy == null contam como disponíveis)
            (
              resource.data.get('status', 'available') == 'available'
              && resource.data.reservedBy == null
            )
            && request.resource.data.status in ['reserved', 'paid']
            && request.resource.data.reservedBy is string
            && request.resource.data.reservedBy.size() > 0
            && request.resource.data.reservedBy.size() <= 100
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'reservedBy', 'reservedAt', 'paidAt', 'updatedAt'])
          )
          || (
            // Comentário do convidado: grava uma vez, só em item reservado/pago
            resource.data.get('status', 'available') in ['reserved', 'paid']
            && resource.data.get('comment', null) == null
            && request.resource.data.comment is string
            && request.resource.data.comment.size() > 0
            && request.resource.data.comment.size() <= 500
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['comment', 'updatedAt'])
          );
      }

      // Configurações do casal: leitura pública, escrita do dono
      match /settings/{docId} {
        allow read: if true;
        allow write: if isOwner(uid);
      }
    }
  }
}
